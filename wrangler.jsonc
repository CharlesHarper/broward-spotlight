{
  // The public website (Astro on Cloudflare Workers)
  "name": "broward-spotlight",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "routes": [
    // Routes sit in front of the existing (proxied) DNS records. Remove these two lines to hand the main address back to the old GHL site.
    { "pattern": "browardspotlight.com/*", "zone_name": "browardspotlight.com" },
    { "pattern": "www.browardspotlight.com/*", "zone_name": "browardspotlight.com" },
    { "pattern": "directory.browardspotlight.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "broward-spotlight",
      // Paste the id printed by: npx wrangler d1 create broward-spotlight
      "database_id": "b0960906-88f6-4a53-84ca-241d5b556ebf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Change to https://browardspotlight.com once the domain is disconnected from GHL (Settings > Domains).
    "SITE_URL": "https://directory.browardspotlight.com",
    "SITE_NAME": "Broward Spotlight"
  }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   ADMIN_PASSWORD   password for /admin (username: admin)
  //   GOOGLE_MAPS_KEY  Google Maps Embed API key (shows a map on each listing)
  //   GHL_WEBHOOK_URL  HighLevel inbound webhook URL for claim, review and advertising events
}
