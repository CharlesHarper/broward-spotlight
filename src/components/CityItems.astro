---
import type { CityItem } from '../lib/citynews';
import { eventDay } from '../lib/citynews';
import { fmtDate } from '../lib/util';
import { cityPhotoUrl } from '../data/cities';
interface Props { items: (CityItem & { city_name?: string | null })[]; kind: 'news' | 'event'; full?: boolean; showCity?: boolean; thumbs?: boolean }
const { items, kind, full = false, showCity = false, thumbs = false } = Astro.props;
const place = (s: string | null) => (s ?? '').split('\n').map((x) => x.trim()).filter(Boolean).join(', ');
---
{kind === 'event' ? (
  <ul class="city-events">
    {items.map((i) => (
      <li>
        <span class="ev-date"><b>{eventDay(i.starts_at).split(', ')[1]}</b><small>{eventDay(i.starts_at).split(', ')[0]}</small></span>
        <span class="ev-body">
          <a href={i.url} target="_blank" rel="noopener">{i.title}</a>
          <small>{[showCity ? i.city_name : null, i.time_text, place(i.location)].filter(Boolean).join(' · ') || 'All day'}</small>
        </span>
      </li>
    ))}
  </ul>
) : (
  <ul class:list={['city-news', { 'with-thumbs': thumbs }]}>
    {items.map((i) => {
      const img = thumbs ? cityPhotoUrl(i.city_slug, 320) : null;
      return (
      <li>
        {thumbs && (img ? <img class="city-thumb" src={img} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span class="city-thumb city-thumb-empty" aria-hidden="true">{(i.city_name ?? i.source ?? '?').replace(/^(City|Town|Village) of /, '').slice(0, 1)}</span>)}
        <span class="news-body">
          <a href={i.url} target="_blank" rel="noopener">{i.title}</a>
          <small>{[i.source, i.published_at ? fmtDate(i.published_at.slice(0, 10)) : null].filter(Boolean).join(' · ')}</small>
          {full && i.summary && <p>{i.summary}</p>}
        </span>
      </li>
    ); })}
  </ul>
)}
