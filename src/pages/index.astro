---
import Base from '../layouts/Base.astro';
import ListingCard from '../components/ListingCard.astro';
import Featured from '../components/Featured.astro';
import Status from '../components/Status.astro';
import Ad from '../components/Ad.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { featured, recentFlagged, cityCounts, activeAd, CARD_EXTRAS } from '../lib/db';
import type { Business, Inspection } from '../lib/db';
import { CATEGORIES, CITY_NAMES } from '../lib/shared';
import { env, fmtDate } from '../lib/util';

const db = env(Astro.locals).DB;
const [feat, flagged, cities, ad, totals, cats, verified, latest] = await Promise.all([
  featured(db, { limit: 3 }),
  recentFlagged(db, 14, 6),
  cityCounts(db),
  activeAd(db, 'home'),
  db.prepare(`SELECT (SELECT COUNT(*) FROM businesses WHERE status='active') AS biz, (SELECT COUNT(*) FROM inspections) AS insp, (SELECT MAX(date) FROM inspections) AS latest, (SELECT COUNT(*) FROM businesses WHERE claimed = 1) AS owners`).first<{ biz: number; insp: number; latest: string | null; owners: number }>(),
  db.prepare(`SELECT category, COUNT(*) AS n FROM businesses WHERE status = 'active' GROUP BY category`).all<{ category: string; n: number }>().then((r) => Object.fromEntries(r.results.map((x) => [x.category, x.n]))),
  db.prepare(`SELECT b.*, ${CARD_EXTRAS} FROM businesses b WHERE b.status = 'active' AND b.claimed = 1 ORDER BY (photo_key IS NOT NULL) DESC, b.updated_at DESC LIMIT 6`).all<Business>().then((r) => r.results),
  db.prepare(`SELECT i.*, b.name, b.slug, b.city FROM inspections i JOIN businesses b ON b.id = i.business_id WHERE b.status = 'active' ORDER BY i.date DESC, i.id DESC LIMIT 6`).all<Inspection>().then((r) => r.results),
]);
const topCities = cities.filter((c) => c.n > 0).sort((a, b) => b.n - a.n);
const report = flagged.items.length ? flagged.items : latest;
const quick = ['restaurants', 'auto', 'home-services', 'beauty', 'health'];
const site = env(Astro.locals).SITE_URL;
const homeLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: 'Broward Spotlight',
      potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
    { '@type': 'Organization', '@id': `${site}/#org`, name: 'Broward Spotlight', url: site, logo: `${site}/og.png`, areaServed: 'Broward County, Florida' },
  ],
};
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<Base title="Broward County Business Directory" jsonld={homeLd} description="Search Broward County businesses with the facts on the record: state restaurant inspections, license status, verified owners and real customer reviews.">
  <div class="hero">
    <div class="wrap">
      <p class="label" style="color:var(--spot)">Broward County, on the record</p>
      <h1>Know who you're <span class="hl">trusting</span> before you go.</h1>
      <p>Look up any Broward business: state inspection results, license records and real reviews. Nobody can pay to change a record.</p>
      <form action="/search" method="get" role="search">
        <label class="sr" for="hq">Search</label>
        <input id="hq" name="q" placeholder="Try “tacos”, “barber”, a business name…" />
        <label class="sr" for="hc">City</label>
        <select id="hc" name="city">
          <option value="">All of Broward</option>
          {Object.entries(CITY_NAMES).map(([s, n]) => <option value={s}>{n}</option>)}
        </select>
        <button class="btn btn-spot" type="submit">Search</button>
      </form>
      <nav class="hero-cats" aria-label="Popular categories">
        {quick.map((slug) => { const c = CATEGORIES.find((x) => x.slug === slug)!; return <a href={`/category/${slug}`}><CategoryIcon slug={slug} size={16} />{c.label}</a>; })}
      </nav>
      <p class="hero-proof"><span><b>{(totals?.biz ?? 0).toLocaleString()}</b> businesses</span><span><b>{(totals?.insp ?? 0).toLocaleString()}</b> state inspections</span><span><b>31</b> cities</span></p>
    </div>
  </div>

  <div class="wrap stack-lg" style="margin-top:28px">
    <Featured items={feat} />

    <section>
      <div class="section-head"><h2>Browse by category</h2><a href="/categories">All categories</a></div>
      <div class="tiles">
        {CATEGORIES.map((c) => (
          <a class="tile" href={`/category/${c.slug}`}>
            <span class:list={['thumb', `tint-${c.slug}`]}><CategoryIcon slug={c.slug} size={22} /></span>
            <span><b>{c.label}</b>{cats[c.slug] ? <small>{cats[c.slug].toLocaleString()}</small> : null}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="section-head">
        <h2>{flagged.items.length ? "This week's inspection warnings" : 'Latest restaurant inspections'}</h2>
        <a href="/inspections">Full report</a>
      </div>
      <div class="grid">
        {report.map((i) => (
          <a class="card" href={`/business/${i.slug}`}>
            <span class="record muted">{fmtDate(i.date)}{i.type ? ` · ${i.type}` : ''}</span>
            <h3>{i.name}</h3>
            <p class="meta">{i.city}</p>
            <Status tone={i.tone} text={i.disposition} />
          </a>
        ))}
      </div>
      <p class="small muted" style="margin-top:10px">From Florida DBPR food service inspections{totals?.latest ? `, through ${fmtDate(totals.latest)}` : ''}. Shown exactly as the state records them.</p>
    </section>

    {verified.length > 0 && (
      <section>
        <div class="section-head"><h2>Owner-verified businesses</h2><a href="/claim">Verify yours</a></div>
        <div class="grid">{verified.map((b) => <ListingCard b={b} />)}</div>
      </section>
    )}

    <section>
      <div class="section-head"><h2>Browse by city</h2><a href="/cities">All 31 cities</a></div>
      <div class="city-tiles">
        {(topCities.length ? topCities : cities).slice(0, 12).map((c) => <a href={`/city/${c.slug}`}>{c.name}{c.n > 0 && <small>{c.n.toLocaleString()}</small>}</a>)}
      </div>
    </section>

    <Ad ad={ad} />

    <section>
      <div class="section-head"><h2>How Broward Spotlight works</h2><a href="/how-it-works">Our standards</a></div>
      <div class="steps">
        <div class="step"><span class="num">1</span><h3>Facts from the record</h3><p class="small muted">Every listing starts from Broward County and State of Florida records, including every restaurant inspection, in the state's own words.</p></div>
        <div class="step"><span class="num">2</span><h3>Owners add the details</h3><p class="small muted">Owners claim their listing free to add their phone, website, hours, photos and story, and to reply to reviews.</p></div>
        <div class="step"><span class="num">3</span><h3>Customers tell the rest</h3><p class="small muted">Real customers leave reviews. We post every genuine one, good or bad, and nobody can pay to change that.</p></div>
      </div>
    </section>

    <section class="owner-band">
      <div class="stack" style="gap:8px">
        <p class="label" style="color:var(--spot)">For business owners</p>
        <h2>Your business is probably already here.</h2>
        <p>Claim it free in about a minute. Add your phone, hours, website and photos, answer reviews, and get the Owner verified check.</p>
      </div>
      <div class="row-actions">
        <a class="btn btn-spot" href="/claim">Find and claim your listing</a>
        <a class="btn" href="/add-business">Add your business</a>
      </div>
    </section>
  </div>
</Base>
