---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import Featured from '../../components/Featured.astro';
import Pager from '../../components/Pager.astro';
import Ad from '../../components/Ad.astro';
import { listBusinesses, featured, activeAd } from '../../lib/db';
import { CATEGORIES, CITY_NAMES } from '../../lib/shared';
import { env } from '../../lib/util';

const db = env(Astro.locals).DB;
const cat = CATEGORIES.find((c) => c.slug === Astro.params.slug);
if (!cat) return Astro.rewrite('/404');
const cityParam = Astro.url.searchParams.get('city');
const city = cityParam && CITY_NAMES[cityParam] ? cityParam : null;
const page = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const [list, feat, ad, byCity] = await Promise.all([
  listBusinesses(db, { category: cat.slug, city, page }),
  featured(db, { category: cat.slug, city, limit: 3 }),
  activeAd(db, 'category', cat.slug),
  db.prepare(`SELECT city_slug, COUNT(*) AS n FROM businesses WHERE category = ? AND status = 'active' AND city_slug IS NOT NULL GROUP BY city_slug ORDER BY n DESC`).bind(cat.slug).all<{ city_slug: string; n: number }>(),
]);
const cityLinks = byCity.results.filter((r) => CITY_NAMES[r.city_slug]);
const title = city ? `${cat.label} in ${CITY_NAMES[city]}, FL` : `${cat.label} in Broward County`;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<Base title={title} description={`${cat.blurb} ${list.total.toLocaleString()} listings across Broward County, with public records and reviews.`} search city={city} noindex={list.total === 0 || page > 1}>
  <div class="wrap stack-lg">
    <header class="stack">
      <p class="label"><a href="/categories">Categories</a></p>
      <h1>{title}</h1>
      <p class="muted" style="max-width:65ch">{cat.blurb}</p>
    </header>
    {cityLinks.length > 0 && (
      <nav class="chips" aria-label="Cities">
        <a class="chip" href={`/category/${cat.slug}`} aria-current={!city ? 'page' : undefined}>All of Broward</a>
        {cityLinks.map((r) => <a class="chip" href={`/category/${cat.slug}?city=${r.city_slug}`} aria-current={city === r.city_slug ? 'page' : undefined}>{CITY_NAMES[r.city_slug]} <span class="n">{r.n.toLocaleString()}</span></a>)}
      </nav>
    )}
    <Featured items={feat} />
    <section>
      <div class="section-head"><h2>Listings <span class="muted small">({list.total.toLocaleString()})</span></h2></div>
      {list.items.length ? <div class="grid">{list.items.map((b) => <ListingCard b={b} />)}</div>
        : <p class="notice">Nothing listed in this category yet. Know a great one? <a href="/add-business">Add it</a>.</p>}
      <Pager page={list.page} total={list.total} base={Astro.url} />
    </section>
    <Ad ad={ad} />
  </div>
</Base>
