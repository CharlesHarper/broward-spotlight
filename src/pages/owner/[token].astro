---
import Base from '../../layouts/Base.astro';
import { env, fmtDate } from '../../lib/util';
import type { Business, Review } from '../../lib/db';
import { livePhotos, MAX_PHOTOS } from '../../lib/photos';
const e = env(Astro.locals);
const b = await e.DB.prepare(`SELECT * FROM businesses WHERE owner_token = ?`).bind(Astro.params.token).first<Business>();
if (!b) return new Response('This owner link is not valid. Ask us for a new one.', { status: 404 });
const { results: reviews } = await e.DB.prepare(`SELECT * FROM reviews WHERE business_id = ? AND status = 'approved' ORDER BY created_at DESC`).bind(b.id).all<Review>();
const saved = Astro.url.searchParams.get('saved');
const photos = await livePhotos(e.DB, b.id);
const room = MAX_PHOTOS - photos.length;
const t = Astro.params.token;
---
<Base title={`Manage ${b.name}`} noindex>
  <div class="wrap stack-lg" style="max-width:820px">
    <header class="stack">
      <p class="label">Owner page · keep this link private</p>
      <h1>{b.name}</h1>
      <p><a href={`/business/${b.slug}`}>View your public listing</a></p>
    </header>
    {saved && <p class="notice notice-ok" role="status">{saved === 'photos' ? 'Photos updated.' : 'Saved. Your listing is updated.'}</p>}
    <form method="post" action="/api/owner/update" class="panel stack">
      <h2>Listing details</h2>
      <input type="hidden" name="token" value={t} />
      <label class="field"><span>Public phone</span><input name="phone" type="tel" value={b.phone ?? ''} /></label>
      <label class="field"><span>Website</span><input name="website" type="url" value={b.website ?? ''} placeholder="https://" /></label>
      <label class="field"><span>Public email (optional)</span><input name="email" type="email" value={b.email ?? ''} /></label>
      <label class="field"><span>Hours</span><textarea name="hours" maxlength="500" placeholder="Mon–Fri 9–6&#10;Sat 10–4&#10;Sun closed">{b.hours ?? ''}</textarea></label>
      <label class="field"><span>About your business</span><textarea name="description" maxlength="2000">{b.description ?? ''}</textarea><small>Shown with the note "Written by the business owner".</small></label>
      <label class="field"><span>Facebook page URL</span><input name="facebook" type="url" value={b.facebook ?? ''} /></label>
      <label class="field"><span>Instagram profile URL</span><input name="instagram" type="url" value={b.instagram ?? ''} /></label>
      <button class="btn btn-primary" type="submit">Save changes</button>
    </form>
    <section class="panel stack" id="photos">
      <h2>Photos</h2>
      <p class="small muted">Up to {MAX_PHOTOS} photos of your business: storefront, work, team, menu items. They appear at the top of your listing. Large pictures are resized for you, and hidden camera details such as location are removed.</p>
      {photos.length > 0 && (
        <div class="photo-admin">
          {photos.map((p) => (
            <figure>
              <img src={`/photo/${p.key}.jpg`} alt={p.caption ?? 'Listing photo'} loading="lazy" />
              {p.caption && <figcaption class="small">{p.caption}</figcaption>}
              <form method="post" action="/api/owner/photo-delete">
                <input type="hidden" name="token" value={t} /><input type="hidden" name="photo_id" value={p.id} />
                <button class="btn btn-sm" type="submit">Remove</button>
              </form>
            </figure>
          ))}
        </div>
      )}
      {room > 0 ? (
        <form method="post" action="/api/owner/photo" enctype="multipart/form-data" class="stack" id="photo-form" data-room={room}>
          <input type="hidden" name="token" value={t} />
          <label class="field"><span>Add {room === 1 ? 'a photo' : `photos (${room} more)`}</span><input name="file" type="file" accept="image/jpeg,image/png,image/webp" required multiple /></label>
          <label class="field"><span>Short description (optional)</span><input name="caption" maxlength="120" placeholder="e.g. Our front counter" /><small>Read aloud to people using screen readers, and helps search engines understand the picture.</small></label>
          <label class="check"><input type="checkbox" name="rights" required /><span>These are my photos, or I have permission to use them, and they show this business.</span></label>
          <button class="btn btn-primary" type="submit">Upload</button>
          <p class="small" id="photo-status" role="status" aria-live="polite"></p>
        </form>
      ) : <p class="notice">You've reached {MAX_PHOTOS} photos. Remove one to add another.</p>}
    </section>
    <section class="stack">
      <h2>Reply to reviews</h2>
      {reviews.length ? reviews.map((r) => (
        <form method="post" action="/api/owner/respond" class="panel stack">
          <input type="hidden" name="token" value={t} />
          <input type="hidden" name="review_id" value={r.id} />
          <p><strong>{'★'.repeat(r.rating)}</strong> · {r.name} · <span class="muted">{fmtDate(r.created_at)}</span></p>
          <p style="white-space:pre-line">{r.body}</p>
          <label class="field"><span>Your public reply</span><textarea name="response" maxlength="1500">{r.owner_response ?? ''}</textarea></label>
          <button class="btn" type="submit">{r.owner_response ? 'Update reply' : 'Post reply'}</button>
        </form>
      )) : <p class="muted">No reviews yet.</p>}
    </section>
    <section class="panel panel-sunk stack">
      <h2>Want more customers to find you?</h2>
      <p>Featured listings sit at the top of your city and category pages, clearly labeled. Your reviews and records stay exactly the same.</p>
      <a class="btn btn-spot" href="/advertise">See Featured options</a>
    </section>
  </div>
</Base>

<script>
  // Resize each picture in the browser before sending it: faster uploads, and it strips camera details.
  const form = document.getElementById('photo-form') as HTMLFormElement | null;
  if (form && 'createImageBitmap' in window) {
    const status = document.getElementById('photo-status')!;
    const btn = form.querySelector('button')!;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const input = form.elements.namedItem('file') as HTMLInputElement;
      const token = (form.elements.namedItem('token') as HTMLInputElement).value;
      const caption = (form.elements.namedItem('caption') as HTMLInputElement).value;
      const files = Array.from(input.files ?? []).slice(0, Number(form.dataset.room) || 1);
      if (!files.length) return;
      btn.disabled = true;
      let done = 0;
      const problems: string[] = [];
      for (const file of files) {
        status.textContent = `Uploading ${done + 1} of ${files.length}…`;
        try {
          const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
          const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
          const c = document.createElement('canvas');
          c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
          const g = c.getContext('2d')!;
          g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height);
          g.drawImage(bmp, 0, 0, c.width, c.height);
          let q = 0.84, blob: Blob | null = null;
          do { blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', q)); q -= 0.12; } while (blob && blob.size > 900_000 && q > 0.35);
          if (!blob) throw new Error('This browser could not prepare the photo.');
          const fd = new FormData();
          fd.set('token', token); fd.set('rights', 'on'); fd.set('caption', files.length === 1 ? caption : '');
          fd.set('file', blob, 'photo.jpg');
          const res = await fetch('/api/owner/photo', { method: 'POST', body: fd, headers: { accept: 'application/json' } });
          const out = await res.json().catch(() => ({ ok: false, error: 'Upload failed.' }));
          if (!out.ok) throw new Error(out.error || 'Upload failed.');
          done++;
        } catch (err) {
          problems.push(`${file.name}: ${err instanceof Error ? err.message : 'could not be read as a photo'}`);
        }
      }
      if (problems.length) { status.textContent = `${done} uploaded. ${problems.join(' ')}`; btn.disabled = false; if (done) setTimeout(() => location.reload(), 2500); }
      else location.href = `/owner/${token}?saved=photos#photos`;
    });
  }
</script>
