---
import Base from '../layouts/Base.astro';
import BotFields from '../components/BotFields.astro';
import { env } from '../lib/util';
import { payLink } from '../lib/plans';
const e = env(Astro.locals);
const canPay = !!(payLink(e, 'featured') || payLink(e, 'spotlight'));
const adLink = payLink(e, 'ad');
const sent = Astro.url.searchParams.get('sent');
const waitlist = Astro.url.searchParams.get('waitlist') ?? '';
const [wCity, wCat] = waitlist.split(':');
const waitTarget = wCity && wCat ? `Waitlist: ${wCat} in ${wCity}` : '';
import { subscriberCount } from '../lib/newsletter';
const subs = await subscriberCount(e.DB);
const tiers = [
  { name: 'Claimed listing', price: 'Free', per: '', items: ['Owner verified badge', 'Add phone, website, hours, photos and description', 'Reply to every review', 'Get notified about new reviews'], cta: 'Find your listing', href: '/search', spot: false },
  { name: 'Featured', price: '$79', per: '/month', items: ['Top of your city and category pages, labeled Featured', 'Shown in matching searches', 'Includes everything in a claimed listing', 'Cancel any month'], cta: 'Get Featured', href: canPay ? '/claim?for=featured' : '#inquire', spot: true },
  { name: 'Spotlight article', price: '$249', per: ' one time', items: ['A researched feature story about your business', 'Labeled Sponsored, written by our editors', 'Yours to share on social and your site', 'Stays up as long as the site does'], cta: 'Book a Spotlight', href: canPay ? '/claim?for=spotlight' : '#inquire', spot: false },
  { name: 'Display ad', price: '$99', per: '/month', items: ['Banner on the city or category pages you pick', 'Labeled Advertisement', 'Links to your site or offer', 'Swap creative any time'], cta: 'Run an ad', href: adLink ?? '#inquire', ext: !!adLink, spot: false },
];
---
<Base title="Advertise on Broward Spotlight" description="Featured placement, sponsored Spotlight articles and display ads for Broward County businesses. Paid placement is always labeled and never changes records or reviews.">
  <div class="wrap stack-lg">
    <header class="stack" style="max-width:720px">
      <p class="label">For Broward businesses</p>
      <h1>Get seen by people already looking</h1>
      <p>People come to Broward Spotlight to decide where to eat and who to hire. Paid placement puts you in front of them, clearly labeled, so readers keep trusting what they see.</p>
    </header>
    <div class="tiers">
      {tiers.map((t) => (
        <section class:list={['panel', 'tier']} style={t.spot ? 'border-color:var(--line-strong);box-shadow:var(--shadow-lift)' : ''}>
          {t.spot && <span class="badge badge-featured" style="justify-self:start">Most popular</span>}
          <h2 style="font-size:19px">{t.name}</h2>
          <p><span class="price">{t.price}</span><span class="muted">{t.per}</span></p>
          <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
          <a class:list={['btn', t.spot ? 'btn-spot' : 'btn-primary']} href={t.href} {...((t as any).ext ? { target: '_blank', rel: 'noopener' } : {})}>{t.cta}</a>
        </section>
      ))}
    </div>
    {canPay && <p class="small muted" style="max-width:820px">Featured and Spotlight attach to your listing, so you buy them from your owner page after you claim the listing (free, about a minute). Already claimed? Open the owner link we emailed you.</p>}
    {adLink && <p class="small muted" style="max-width:820px">Display ads: after you pay, we email you a private link where you upload your banner and pick where it shows. It goes live as soon as you upload.</p>}
    <section class="panel panel-sunk stack" style="max-width:820px">
      <h2>What paying does and doesn't do</h2>
      <p><strong>Does:</strong> moves your listing into labeled Featured spots, publishes a labeled Sponsored story, or shows a labeled ad.</p>
      <p><strong>Doesn't:</strong> hide or change a state inspection or license record, remove or reorder reviews, or buy a verified badge. Those are the same for every business, paying or not.</p>
    </section>
    <section class="panel stack" id="newsletter" style="max-width:820px">
      <h2>Sponsor "This Week in Broward"</h2>
      <p>One labeled sponsor spot in our free weekly email of Broward events, city news and restaurant inspections{subs > 50 ? `, sent to ${subs.toLocaleString()} subscribers` : ''}. Your logo, two lines and a link. One sponsor per week. Ask below for open weeks and the current rate.</p>
    </section>
    <section id="inquire" style="max-width:720px">
      {sent ? <p class="notice notice-ok" role="status">Thanks. We'll reach out within one business day with available spots and next steps.</p> : (
        <form method="post" action="/api/advertise" class="panel stack">
          <h2>Tell us what you're interested in</h2>
          <BotFields />
          <label class="field"><span>Your name</span><input name="name" required maxlength="80" autocomplete="name" /></label>
          <label class="field"><span>Business name</span><input name="business_name" required maxlength="120" /></label>
          <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
          <label class="field"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label class="field"><span>Interested in</span>
            <select name="interest" required><option value="">Choose one</option><option>Featured</option><option>Spotlight article</option><option>Display ad</option><option>Weekly email sponsor</option><option>Featured waitlist</option><option>Not sure yet</option></select>
          </label>
          <label class="field"><span>Which cities or categories? (optional)</span><input name="target" maxlength="200" value={waitTarget} /></label>
          <button class="btn btn-primary" type="submit">Send</button>
        </form>
      )}
    </section>
  </div>
</Base>
