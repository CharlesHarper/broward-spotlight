---
import Base from '../layouts/Base.astro';
import BotFields from '../components/BotFields.astro';
const sent = Astro.url.searchParams.get('sent');
const tiers = [
  { name: 'Claimed listing', price: 'Free', per: '', items: ['Owner verified badge', 'Add website, hours, photos and description', 'Reply to every review', 'Get notified about new reviews'], cta: 'Find your listing', href: '/search', spot: false },
  { name: 'Featured', price: '$79', per: '/month', items: ['Top of your city and category pages, labeled Featured', 'Shown in matching searches', 'Includes everything in a claimed listing', 'Cancel any month'], cta: 'Get Featured', href: '#inquire', spot: true },
  { name: 'Spotlight article', price: '$249', per: ' one time', items: ['A researched feature story about your business', 'Labeled Sponsored, written by our editors', 'Yours to share on social and your site', 'Stays up as long as the site does'], cta: 'Book a Spotlight', href: '#inquire', spot: false },
  { name: 'Display ad', price: '$99', per: '/month', items: ['Banner on the city or category pages you pick', 'Labeled Advertisement', 'Links to your site or offer', 'Swap creative any time'], cta: 'Run an ad', href: '#inquire', spot: false },
];
---
<Base title="Advertise on Broward Spotlight" description="Featured placement, sponsored Spotlight articles and display ads for Broward County businesses. Paid placement is always labeled and never changes records or reviews.">
  <div class="wrap stack-lg">
    <header class="stack" style="max-width:720px">
      <p class="label">For Broward businesses</p>
      <h1>Get seen by people already looking</h1>
      <p>People come to Broward Spotlight to decide where to eat and who to hire. Paid placement puts you in front of them, clearly labeled, so readers keep trusting what they see.</p>
    </header>
    <div class="tiers">
      {tiers.map((t) => (
        <section class:list={['panel', 'tier']} style={t.spot ? 'border-color:var(--line-strong);box-shadow:var(--shadow-lift)' : ''}>
          {t.spot && <span class="badge badge-featured" style="justify-self:start">Most popular</span>}
          <h2 style="font-size:19px">{t.name}</h2>
          <p><span class="price">{t.price}</span><span class="muted">{t.per}</span></p>
          <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
          <a class:list={['btn', t.spot ? 'btn-spot' : 'btn-primary']} href={t.href}>{t.cta}</a>
        </section>
      ))}
    </div>
    <section class="panel panel-sunk stack" style="max-width:820px">
      <h2>What paying does and doesn't do</h2>
      <p><strong>Does:</strong> moves your listing into labeled Featured spots, publishes a labeled Sponsored story, or shows a labeled ad.</p>
      <p><strong>Doesn't:</strong> hide or change a state inspection or license record, remove or reorder reviews, or buy a verified badge. Those are the same for every business, paying or not.</p>
    </section>
    <section id="inquire" style="max-width:720px">
      {sent ? <p class="notice notice-ok" role="status">Thanks. We'll reach out within one business day with available spots and next steps.</p> : (
        <form method="post" action="/api/advertise" class="panel stack">
          <h2>Tell us what you're interested in</h2>
          <BotFields />
          <label class="field"><span>Your name</span><input name="name" required maxlength="80" autocomplete="name" /></label>
          <label class="field"><span>Business name</span><input name="business_name" required maxlength="120" /></label>
          <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
          <label class="field"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" /></label>
          <label class="field"><span>Interested in</span>
            <select name="interest" required><option value="">Choose one</option><option>Featured</option><option>Spotlight article</option><option>Display ad</option><option>Not sure yet</option></select>
          </label>
          <label class="field"><span>Which cities or categories? (optional)</span><input name="target" maxlength="200" /></label>
          <button class="btn btn-primary" type="submit">Send</button>
        </form>
      )}
    </section>
  </div>
</Base>
