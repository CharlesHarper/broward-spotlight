---
import Base from '../../../layouts/Base.astro';
import ListingCard from '../../../components/ListingCard.astro';
import Featured from '../../../components/Featured.astro';
import Status from '../../../components/Status.astro';
import Pager from '../../../components/Pager.astro';
import Ad from '../../../components/Ad.astro';
import { listBusinesses, featured, cityStats, cityRow, activeAd } from '../../../lib/db';
import { CATEGORIES, categoryLabel } from '../../../lib/shared';
import { env, fmtDate } from '../../../lib/util';
import CityItems from '../../../components/CityItems.astro';
import { cityItems } from '../../../lib/citynews';
import { CITY_INFO, cityPhotoUrl } from '../../../data/cities';

const db = env(Astro.locals).DB;
const slug = Astro.params.slug!;
const city = await cityRow(db, slug);
if (!city) return Astro.rewrite('/404');
// /city/davie lists everything; /city/davie/restaurants lists one category. The old ?category= form forwards to the clean address.
const isCat = (c: string | null | undefined) => CATEGORIES.some((x) => x.slug === c);
const legacyCat = Astro.url.searchParams.get('category');
const pathCat = Astro.params.category;
if (!pathCat && isCat(legacyCat)) return Astro.redirect(`/city/${slug}/${legacyCat}`, 301);
if (pathCat && !isCat(pathCat)) return Astro.rewrite('/404');
const category = pathCat ?? null;
const page = Number(Astro.url.searchParams.get('page') ?? 1) || 1;
const [list, feat, stats, ad] = await Promise.all([
  listBusinesses(db, { city: slug, category, page }),
  featured(db, { city: slug, category, limit: 3 }),
  cityStats(db, slug),
  activeAd(db, 'city', slug),
]);
const [events, news] = category ? [[], []] : await Promise.all([cityItems(db, slug, 'event', 5), cityItems(db, slug, 'news', 5)]);
const since90 = new Date(Date.now() - 90 * 864e5).toISOString().slice(0, 10);
const catStats = category ? await db.prepare(`SELECT COUNT(*) AS n, SUM(claimed) AS claimed, SUM(CASE WHEN last_inspection_date >= ?3 THEN 1 ELSE 0 END) AS inspected
  FROM businesses WHERE city_slug = ?1 AND category = ?2 AND status = 'active'`).bind(slug, category, since90).first<{ n: number; claimed: number | null; inspected: number | null }>() : null;
const okShare = stats.inspected90 ? Math.round(((stats.tones.ok ?? 0) / stats.inspected90) * 100) : null;
const top3 = stats.categories.slice(0, 3).map((c) => `${categoryLabel(c.category).toLowerCase()} (${c.n.toLocaleString()})`);
const facts = [
  `${city.name} has ${stats.listings.toLocaleString()} businesses listed on Broward Spotlight${top3.length ? `. The largest groups are ${top3.join(', ')}` : ''}.`,
  stats.inspected90 ? `In the last 90 days, Florida inspectors made ${stats.inspected90.toLocaleString()} food-service ${stats.inspected90 === 1 ? 'inspection' : 'inspections'} in ${city.name}; ${okShare}% ended with no further action or a complied call-back.` : '',
  stats.closures365 ? `${stats.closures365} ${stats.closures365 === 1 ? 'business has' : 'businesses have'} had a state emergency order in the last 12 months.` : '',
].filter(Boolean).join(' ');
const catInfo = category ? CATEGORIES.find((c) => c.slug === category)! : null;
const catFacts = catInfo && catStats ? [
  `${city.name} has ${catStats.n.toLocaleString()} ${catStats.n === 1 ? 'listing' : 'listings'} under ${catInfo.label.toLowerCase()} on Broward Spotlight, built from Broward County and State of Florida public records.`,
  catStats.inspected ? `${catStats.inspected.toLocaleString()} ${catStats.inspected === 1 ? 'was' : 'were'} inspected by the state in the last 90 days, and each listing shows the result in the state's own words.` : '',
  catStats.claimed ? `${catStats.claimed} ${catStats.claimed === 1 ? 'is' : 'are'} verified by the owner.` : '',
  `Covers: ${catInfo.blurb.charAt(0).toLowerCase()}${catInfo.blurb.slice(1)}`,
].filter(Boolean).join(' ') : '';
const info = CITY_INFO[slug] ?? null;
const photo = cityPhotoUrl(slug);
const site = env(Astro.locals).SITE_URL;
const selfPath = `/city/${slug}${category ? `/${category}` : ''}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Broward County', item: `${site}/cities` },
      { '@type': 'ListItem', position: 2, name: city.name, item: `${site}/city/${slug}` },
      ...(category ? [{ '@type': 'ListItem', position: 3, name: categoryLabel(category), item: `${site}${selfPath}` }] : []),
    ] },
    ...(list.items.length ? [{ '@type': 'ItemList', name: category ? `${categoryLabel(category)} in ${city.name}, FL` : `Businesses in ${city.name}, FL`, numberOfItems: list.total,
      itemListElement: list.items.map((b, n) => ({ '@type': 'ListItem', position: (list.page - 1) * 24 + n + 1, name: b.name, url: `${site}/business/${b.slug}` })) }] : []),
  ],
};
const title = category ? `${categoryLabel(category)} in ${city.name}, FL` : `${city.name}, FL businesses`;
const desc = category
  ? `${list.total.toLocaleString()} ${categoryLabel(category).toLowerCase()} listings in ${city.name}, Florida, built from public records, with owner-verified details and customer reviews where available.`
  : `${stats.listings.toLocaleString()} ${city.name} businesses with state inspection results, license records and reviews. ${stats.inspected90} inspections in the last 90 days.`;
// A city-and-category view needs enough listings to be worth a search result; this matches the sitemap rule.
const indexable = page === 1 && (category ? list.total >= 5 : stats.listings > 0);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---
<Base title={title} description={desc} image={photo ? `${site.replace(/\/$/, '')}${photo}` : null} search city={slug} noindex={!indexable} canonical={`${site}${selfPath}`} jsonld={jsonld}>
  <div class="wrap stack-lg">
    {photo && info?.photo && (
      <figure class="city-hero">
        <img src={photo} srcset={`${cityPhotoUrl(slug, 640)} 640w, ${cityPhotoUrl(slug, 960)} 960w, ${photo} 1280w`} sizes="(max-width: 1200px) 100vw, 1200px" alt={info.photo.alt} width="1280" height="720" fetchpriority={category ? 'auto' : 'high'} decoding="async" />
        <figcaption>Photo: {info.photo.credit}, <a href={`https://commons.wikimedia.org/wiki/File:${encodeURIComponent(info.photo.file.replace(/ /g, '_'))}`} target="_blank" rel="noopener">{info.photo.license}</a>, via Wikimedia Commons</figcaption>
      </figure>
    )}
    <header class="stack">
      <p class="label"><a href="/cities">Cities</a> / {category ? <a href={`/city/${slug}`}>{city.name}</a> : 'Broward County'}</p>
      <h1>{category ? `${categoryLabel(category)} in ${city.name}` : city.name}</h1>
      {city.intro && <p style="max-width:65ch">{city.intro}</p>}
      <p style="max-width:70ch">{category ? catFacts : facts}</p>
    </header>

    <section aria-label={`${city.name} by the numbers`}>
      <div class="stats">
        <div class="stat"><b>{stats.listings.toLocaleString()}</b><span>Listed businesses</span></div>
        <div class="stat"><b>{stats.inspected90.toLocaleString()}</b><span>State inspections, last 90 days</span></div>
        <div class="stat"><b>{okShare === null ? '—' : `${okShare}%`}</b><span>No further action or complied call-back, last 90 days</span></div>
        <div class="stat"><b>{stats.closures365}</b><span>Businesses with an emergency order, last 12 months</span></div>
      </div>
      <p class="small muted" style="margin-top:8px">Inspection figures cover food service businesses inspected by Florida DBPR.</p>
    </section>

    {(events.length > 0 || news.length > 0) && (
      <div class="city-feeds">
        {events.length > 0 && (
          <section class="panel stack">
            <div class="section-head" style="margin:0"><h2 style="font-size:20px">Upcoming in {city.name}</h2><a href={`/city/${slug}/events`}>All events</a></div>
            <CityItems items={events} kind="event" />
          </section>
        )}
        {news.length > 0 && (
          <section class="panel stack">
            <div class="section-head" style="margin:0"><h2 style="font-size:20px">{city.name} news</h2><a href={`/city/${slug}/news`}>All news</a></div>
            <CityItems items={news} kind="news" />
          </section>
        )}
      </div>
    )}

    <nav class="chips" aria-label="Categories">
      <a class="chip" href={`/city/${slug}`} aria-current={!category ? 'page' : undefined}>All</a>
      {stats.categories.map((c) => (
        <a class="chip" href={`/city/${slug}/${c.category}`} aria-current={category === c.category ? 'page' : undefined}>
          {categoryLabel(c.category)} <span class="n">{c.n.toLocaleString()}</span>
        </a>
      ))}
    </nav>

    <Featured items={feat} />

    <section>
      <div class="section-head">
        <h2>{category ? categoryLabel(category) : 'All businesses'} <span class="muted small">({list.total.toLocaleString()})</span></h2>
      </div>
      {list.items.length ? <div class="grid">{list.items.map((b) => <ListingCard b={b} />)}</div>
        : <p class="notice">No listings here yet. <a href="/add-business">Add a business in {city.name}</a>.</p>}
      <Pager page={list.page} total={list.total} base={Astro.url} />
    </section>

    <Ad ad={ad} />

    {!category && info && info.history.length > 0 && (
      <section class="panel stack history" id="history">
        <h2>History of {city.name}</h2>
        {info.incorporated && <p class="label">Incorporated {info.incorporated}</p>}
        {info.history.map((p) => <p>{p}</p>)}
        <p class="small muted">Sources: <a href={info.wiki} target="_blank" rel="noopener">Wikipedia</a>{city.website && <>, <a href={city.website} target="_blank" rel="noopener">official {city.name} website</a></>}. Written by Broward Spotlight.</p>
      </section>
    )}

    {stats.recent.length > 0 && (
      <section>
        <div class="section-head"><h2>Latest inspections in {city.name}</h2><a href="/inspections">Countywide report</a></div>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Date</th><th>Business</th><th>Result</th></tr></thead>
            <tbody>
              {stats.recent.map((i) => (
                <tr>
                  <td class="record">{fmtDate(i.date)}</td>
                  <td><a href={`/business/${i.slug}`}>{i.name}</a></td>
                  <td><Status tone={i.tone} text={i.disposition} plain /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</Base>
