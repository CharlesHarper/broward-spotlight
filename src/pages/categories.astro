---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/shared';
import { env } from '../lib/util';
const { results } = await env(Astro.locals).DB.prepare(`SELECT category, COUNT(*) AS n FROM businesses WHERE status = 'active' GROUP BY category`).all<{ category: string; n: number }>();
const counts = Object.fromEntries(results.map((r) => [r.category, r.n]));
Astro.response.headers.set('Cache-Control', 'public, max-age=600');
---
<Base title="Categories" description="Every kind of Broward County business, from restaurants and food trucks to roofers, salons and auto shops." search>
  <div class="wrap stack-lg">
    <header class="stack"><h1>Every kind of Broward business</h1></header>
    <div class="grid">
      {CATEGORIES.map((c) => (
        <a class="card" href={`/category/${c.slug}`}>
          <h3>{c.label}</h3>
          <p class="meta">{c.blurb}</p>
          <span class="record muted">{(counts[c.slug] ?? 0).toLocaleString()} listings</span>
        </a>
      ))}
    </div>
  </div>
</Base>
